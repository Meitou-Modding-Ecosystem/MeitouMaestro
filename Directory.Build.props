<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0-playtest.1</Version>
    <MeitouDir Condition="'$(MeitouDir)' == ''">$(MEITOU_DIR)</MeitouDir>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Meitou.Core;Meitou.Data">
      <HintPath>$(MeitouDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckClient" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MeitouDir)/Meitou.Data.dll')" Text="Set MEITOU_DIR to the extracted v0.20.1 game directory." />
  </Target>
</Project>
